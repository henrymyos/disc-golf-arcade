  "private": true,
  "scripts": {
    "predev": "node scripts/dev-cache-guard.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
